PREFIX wd:   <http://www.wikidata.org/entity/>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?episode ?episodeLabel ?seriesOrdinal ?seasonItem ?seasonOrdinal WHERE {
  VALUES ?series { wd:Q117350388 }
  ?episode wdt:P179 ?series ;
           rdfs:label ?episodeLabel .
  FILTER(LANG(?episodeLabel) = "en")
  OPTIONAL { ?episode wdt:P1545 ?seriesOrdinal . }
  OPTIONAL {
    ?episode wdt:P4908 ?seasonItem .
    OPTIONAL { ?seasonItem wdt:P1545 ?seasonOrdinal . }
  }
}
ORDER BY ?episode
LIMIT 40
