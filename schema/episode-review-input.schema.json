{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/trek-data-core/schema/episode-review-input.schema.json",
  "title": "Proposal-only Episode Review Input (not a governed registry record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "packet_id", "fixture_only", "mission_id", "episode", "source", "observations", "assertions"],
  "properties": {
    "record_type": {"const": "episode_review_input"},
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"$ref": "#/$defs/id"},
    "fixture_only": {"type": "boolean"},
    "mission_id": {"enum": ["tos", "tas", "tng", "ds9", "voy", "ent", "dis", "pic", "ld", "pro", "snw", "sfa"]},
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "season", "episode_number", "publisher_roster_url"],
      "properties": {
        "title": {"$ref": "#/$defs/title"},
        "season": {"type": "integer", "minimum": 1, "maximum": 100},
        "episode_number": {"type": "integer", "minimum": 1, "maximum": 1000},
        "publisher_roster_url": {"$ref": "#/$defs/publicUrl"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "locator", "version", "access_basis", "rights_note", "inspection", "inspected_on", "content_sha256"],
      "properties": {
        "kind": {"enum": ["PUBLISHER_METADATA", "EPISODE_CONTENT"]},
        "locator": {"$ref": "#/$defs/publicUrl"},
        "version": {"$ref": "#/$defs/title"},
        "access_basis": {"enum": ["LICENSED_STREAMING", "OWNED_COPY", "RIGHTS_HOLDER_PERMISSION", "PUBLISHER_PUBLIC_METADATA"]},
        "rights_note": {"type": "string", "minLength": 1, "maxLength": 300},
        "inspection": {"enum": ["NOT_INSPECTED", "RESEARCHER_REPORTED"]},
        "inspected_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observations": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/observation"}},
    "assertions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/assertion"}}
  },
  "allOf": [
    {"if": {"properties": {"source": {"properties": {"inspection": {"const": "RESEARCHER_REPORTED"}}}}},
     "then": {
       "properties": {
         "source": {"properties": {"kind": {"const": "EPISODE_CONTENT"}, "access_basis": {"enum": ["LICENSED_STREAMING", "OWNED_COPY", "RIGHTS_HOLDER_PERMISSION"]}, "inspected_on": {"type": "string"}, "content_sha256": {"type": "string"}}},
         "observations": {"minItems": 1}, "assertions": {"minItems": 1}
       }
     },
     "else": {
       "properties": {
         "source": {"properties": {"kind": {"const": "PUBLISHER_METADATA"}, "access_basis": {"const": "PUBLISHER_PUBLIC_METADATA"}, "inspected_on": {"const": null}, "content_sha256": {"const": null}}},
         "observations": {"maxItems": 0}, "assertions": {"maxItems": 0}
       }
     }}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "publicUrl": {"type": "string", "format": "uri", "maxLength": 500, "pattern": "^https://"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "cue_start_seconds", "cue_end_seconds", "kind", "epistemic_status", "original_note"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "cue_start_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "cue_end_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "kind": {"enum": ["depiction", "testimony", "sensor_report", "memory", "document", "narration", "other"]},
        "epistemic_status": {"enum": ["DIRECT", "CONTESTED", "UNRESOLVED", "UNKNOWN"]},
        "original_note": {"type": "string", "minLength": 1, "maxLength": 320}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["assertion_id", "subject", "predicate", "object", "evidence_ids"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/title"},
        "predicate": {"$ref": "#/$defs/title"},
        "object": {"$ref": "#/$defs/title"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$comment": "The CLI also checks Mission catalog membership, HTTPS URL hygiene, plain-text safety, actual date validity, cue span <=600 seconds, unique candidate IDs, and local assertion-to-evidence reference integrity. This schema is not an admission contract."
}
