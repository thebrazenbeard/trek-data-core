{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trek-data-core/schema/local-entity.schema.json",
  "title": "Local Entity",
  "type": "object",
  "required": ["record_type", "local_entity_id", "work_id", "label"],
  "properties": {
    "record_type": {"const": "local_entity"},
    "local_entity_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "entity_kind": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
