{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trek-data-core/schema/projection-manifest.schema.json",
  "title": "Projection Manifest",
  "type": "object",
  "required": [
    "record_type",
    "projection_version",
    "schema_version",
    "methodology_version",
    "compiler_commit",
    "research_head",
    "reconciliation_head",
    "predicate_registry_hash",
    "input_hash",
    "projection_hash",
    "outputs"
  ],
  "properties": {
    "record_type": {"const": "projection_manifest"},
    "projection_version": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "methodology_version": {"type": "string", "minLength": 1},
    "compiler_commit": {"type": "string", "minLength": 1},
    "research_head": {"type": "string", "minLength": 1},
    "reconciliation_head": {"type": "string", "minLength": 1},
    "predicate_registry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputs": {"type": "object"}
  },
  "additionalProperties": true
}
