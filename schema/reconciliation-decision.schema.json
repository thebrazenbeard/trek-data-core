{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trek-data-core/schema/reconciliation-decision.schema.json",
  "title": "Reconciliation Decision",
  "type": "object",
  "required": ["record_type", "decision_id", "decision_type", "subject_type", "subject_id", "payload", "status", "evidence", "method"],
  "properties": {
    "record_type": {"const": "reconciliation_decision"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_type": {"enum": ["ENTITY_LINK", "ASSERTION_DISPOSITION", "ASSERTION_PROJECTION_STATUS", "SCOPE_RESOLUTION", "OTHER"]},
    "subject_type": {"enum": ["SOURCE", "WORK", "LOCAL_ENTITY", "ASSERTION"]},
    "subject_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "method": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
