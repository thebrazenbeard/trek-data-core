{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trek-data-core/schema/work.schema.json",
  "title": "Work (proposal-compatible shape; authoritative records also follow the Librarian contract)",
  "type": "object",
  "required": ["record_type", "work_id", "title"],
  "properties": {
    "record_type": {"const": "work"},
    "work_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "medium": {"type": "string", "minLength": 1},
    "work_type": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "CONTESTED", "SUPERSEDED"]},
    "fixture_only": {"type": "boolean"},
    "component_label": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "series": {"type": ["string", "null"]},
    "continuity_scope": {"type": ["string", "null"]},
    "parent_work_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
